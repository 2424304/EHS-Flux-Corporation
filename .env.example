# ====================================================================
# EHS Flux Corporation — Environment Variables (example)
# Copy this file to .env (local) and set the same variables in Vercel.
# Never commit the real .env file or share it with anyone outside the team.
# ====================================================================

# ---- Resend API key (server-side only) ----
# Get this from https://resend.com/api-keys after creating your account.
# In production, set this in Vercel → Project Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Sender email authorised by Resend ----
# Must be on a domain you have VERIFIED in your Resend dashboard.
# Example: enquiries@ehsflux.com (after verifying ehsflux.com in Resend).
# Until the domain is verified, Resend can only send from onboarding@resend.dev
# (limited to your account email only) for testing.
CONTACT_FROM_EMAIL=enquiries@ehsflux.com

# ---- Recipient inbox (where enquiries are delivered) ----
# The official company enquiry inbox.
CONTACT_TO_EMAIL=info@ehsflux.com
